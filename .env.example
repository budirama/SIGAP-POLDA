# Salin file ini menjadi .env lalu sesuaikan nilainya. File .env TIDAK di-commit.

# development = tampilkan detail error & aktifkan Quick Login uji coba
# production  = sembunyikan detail error & nonaktifkan Quick Login (WAJIB saat deploy)
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigap_polda
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Google Maps JavaScript API (opsional). Kosong = peta memakai Leaflet + OpenStreetMap.
# Batasi key di Google Cloud Console (HTTP referrer) ke domain aplikasi, mis. http://localhost/SIGAP-Polda/*
GOOGLE_MAPS_API_KEY=
